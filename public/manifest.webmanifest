{
  "id": "/",
  "name": "Study with Ahmad",
  "short_name": "Study Ahmad",
  "description": "Study planner for Punjab Board Matric and Inter students: PTB syllabus, focus timer, tasks, timetable, exams and flashcards.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
